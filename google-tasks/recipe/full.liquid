{% assign tasks = data.display_tasks %}
{% assign task_list = data.task_list %}
{% assign stats = data.stats %}

<div
  class="layout"
  style="align-items: stretch; justify-content: flex-start; font-family: Inter, Arial, sans-serif;"
>
  <div
    class="flex flex--col"
    style="width: 100%; height: 100%; max-width: none; align-items: stretch; justify-content: flex-start; gap: 0;"
  >
    {% if tasks and tasks.size > 0 %}
      <div
        data-google-task-list
        data-time-zone="{{ trmnl.user.time_zone_iana | default: 'UTC' }}"
        class="flex flex--col"
        style="flex: 1; min-height: 0; overflow: hidden; align-items: stretch;"
      >
        {% assign recent_section_started = false %}
        {% assign open_section_started = false %}
        {% assign completed_section_started = false %}
        {% for task in tasks %}
          {% assign indent = task.depth | times: 28 %}
          {% assign show_completed_divider = false %}
          {% if task.section == 'recent' and recent_section_started == false %}
            {% assign recent_section_started = true %}
            <div
              data-google-task-row
              class="flex flex--row flex--center-y"
              style="flex: 0 0 auto; width: 100%; min-height: 24px; justify-content: space-between; padding: 0 0 2px; font-size: 14px; font-weight: 500; text-align: left;"
            >
              <span>Last 24 hours</span>
              <span>{{ stats.recent_completed }} done</span>
            </div>
          {% endif %}
          {% if task.section == 'open' and open_section_started == false %}
            {% assign open_section_started = true %}
            {% if stats.recent_completed > 0 %}
              {% assign show_completed_divider = true %}
            {% endif %}
          {% endif %}
          {% if task.section == 'completed' and completed_section_started == false %}
            {% assign completed_section_started = true %}
            {% if stats.open > 0 %}
              {% assign show_completed_divider = true %}
            {% elsif stats.recent_completed > 0 %}
              {% assign show_completed_divider = true %}
            {% endif %}
          {% endif %}

          {% if show_completed_divider %}
            <div
              data-google-task-divider
              style="flex: 0 0 auto; width: 100%; height: 0; margin: 3px 0; border-top: 1px dashed #000;"
            ></div>
          {% endif %}

          {% if task.kind == 'completed_summary' %}
            <div
              data-google-task-row
              class="flex flex--row flex--center-y"
              style="flex: 0 0 auto; width: calc(100% - {{ indent }}px); justify-content: flex-start; gap: 8px; min-height: 28px; margin-left: {{ indent }}px; padding: 2px 0; text-align: left;"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                style="display: block; flex: 0 0 20px;"
                aria-hidden="true"
              >
                <circle cx="10" cy="10" r="8.5" fill="none" stroke="#000" stroke-width="2" />
                <path d="M6 10.2 8.7 13 14.2 7.4" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="font--bold" style="text-align: left;">
                {{ task.title }}
              </div>
            </div>
          {% else %}
            <div
              data-google-task-row
              class="flex flex--row flex--center-y"
              style="flex: 0 0 auto; width: calc(100% - {{ indent }}px); justify-content: flex-start; gap: 10px; min-height: 36px; margin-left: {{ indent }}px; padding: 3px 0; text-align: left;"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                style="display: block; flex: 0 0 24px;"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" {% if task.status == 'completed' %}fill="#000"{% else %}fill="none"{% endif %} stroke="#000" stroke-width="2" />
                {% if task.status == 'completed' %}
                  <path d="M7.3 12.2 10.5 15.5 16.9 8.9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                {% endif %}
              </svg>

              <div
                class="flex flex--col"
                style="flex: 1; min-width: 0; gap: 1px;"
              >
                <div
                  {% if task.status != 'completed' %}
                    class="font--bold"
                  {% endif %}
                  style="width: 100%; font-size: 20px; font-weight: {% if task.section == 'completed' %}400{% else %}500{% endif %}; line-height: 1.15; text-align: left; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                >
                  {{ task.title | default: 'Untitled task' }}
                </div>
                {% if task.notes and task.notes != '' %}
                  <div style="width: 100%; font-size: 14px; line-height: 1.1; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    {{ task.notes -}}
                    {%- if task.completed_descendants > 0 %} · ({{ task.completed_descendants }} completed){% endif %}
                  </div>
                {% elsif task.completed_descendants > 0 %}
                  <div style="width: 100%; font-size: 14px; line-height: 1.1; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    ({{ task.completed_descendants }} completed)
                  </div>
                {% endif %}
              </div>

              {% if task.section == 'recent' and task.completed and task.completed != '' %}
                <div
                  data-completed-time="{{ task.completed }}"
                  class="flex flex--row flex--center-y"
                  style="flex: 0 0 auto; gap: 5px; font-size: 14px; font-weight: 500; text-align: right; white-space: nowrap;"
                  aria-label="Completed at"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    style="display: block; flex: 0 0 16px;"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" fill="none" stroke="#000" stroke-width="2" />
                    <path d="M12 7v5l3.5 2" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span data-completed-time-label></span>
                </div>
              {% elsif task.due and task.due != '' %}
                <div
                  class="flex flex--row flex--center-y"
                  style="flex: 0 0 auto; gap: 5px; font-size: 15px; font-weight: 500; text-align: right; white-space: nowrap;"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    style="display: block; flex: 0 0 16px;"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="#000" stroke-width="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  <span>{{ task.due | date: '%b %e' }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="flex flex--col flex--center-xy" style="flex: 1;">
        <svg width="48" height="48" viewBox="0 0 48 48" style="display: block; margin-bottom: 12px;" aria-hidden="true">
          <circle cx="24" cy="24" r="20" fill="none" stroke="#000" stroke-width="3" />
          <path d="M14.5 24.5 21 31l13-14" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="title title--large">All clear</div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title"> Google Tasks — {{ task_list.title | default: 'My Tasks' }} </span>
  <span class="instance">{{ stats.open | default: 0 }} open</span>
</div>

<script>
  const googleTasksScript = document.currentScript;
  requestAnimationFrame(() => {
    const view = googleTasksScript && googleTasksScript.closest('.view');
    const list = view && view.querySelector('[data-google-task-list]');
    if (!list) return;

    let timeZone = list.dataset.timeZone || 'UTC';
    let completedTimeFormatter;
    const formatterOptions = {
      timeZone,
      day: 'numeric',
      month: 'short',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    };

    try {
      completedTimeFormatter = new Intl.DateTimeFormat('en-SG', formatterOptions);
    } catch (_error) {
      timeZone = 'UTC';
      completedTimeFormatter = new Intl.DateTimeFormat('en-SG', {
        ...formatterOptions,
        timeZone,
      });
    }

    list.querySelectorAll('[data-completed-time]').forEach((element) => {
      const completedAt = new Date(element.dataset.completedTime);
      const label = element.querySelector('[data-completed-time-label]');
      if (!label || Number.isNaN(completedAt.getTime())) {
        element.style.display = 'none';
        return;
      }

      const parts = Object.fromEntries(
        completedTimeFormatter
          .formatToParts(completedAt)
          .filter((part) => part.type !== 'literal')
          .map((part) => [part.type, part.value]),
      );
      label.textContent =
        `${parts.day} ${parts.month} · ${parts.hour}:${parts.minute} ${(parts.dayPeriod || '').toUpperCase()}`.trim();
    });

    const listBottom = list.getBoundingClientRect().bottom;
    let full = false;
    list.querySelectorAll('[data-google-task-row]').forEach((row) => {
      if (full || row.getBoundingClientRect().bottom > listBottom + 1) {
        row.style.display = 'none';
        full = true;
      }
    });

    list.querySelectorAll('[data-google-task-divider]').forEach((divider) => {
      const nextRow = divider.nextElementSibling;
      if (!nextRow || nextRow.style.display === 'none') {
        divider.style.display = 'none';
      }
    });
  });
</script>
