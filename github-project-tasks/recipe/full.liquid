{% assign stats = data.stats %}
{% assign sections = data.sections %}
{% assign recent_done = data.recent_done %}

<div class="layout" style="font-family: 'Open Sans', sans-serif; font-weight: 400;">
  <div style="display: flex; flex-direction: column; width: 100%; height: 100%; overflow: hidden;">
    {% if stats.open == 0 and stats.done_last_24h == 0 %}
      <div style="display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center;">
        <div style="font-size: 26px; font-weight: 400;">All clear</div>
        <div style="font-size: 21px;">No assigned tasks</div>
      </div>
    {% else %}
      {% if stats.open > 0 %}
        {% for section in sections %}
          {% for task in section.tasks %}
            <div style="display: flex; align-items: center; gap: 9px; min-height: 38px; padding: 2px;">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                aria-hidden="true"
                style="flex: 0 0 auto; fill: currentColor;"
              >
                <path d="M12 1c6.075 0 11 4.925 11 11s-4.925 11-11 11S1 18.075 1 12 5.925 1 12 1ZM2.5 12a9.5 9.5 0 0 0 9.5 9.5 9.5 9.5 0 0 0 9.5-9.5A9.5 9.5 0 0 0 12 2.5 9.5 9.5 0 0 0 2.5 12Zm9.5 2a2 2 0 1 1-.001-3.999A2 2 0 0 1 12 14Z" />
              </svg>
              <div style="min-width: 0; flex: 1; font-size: 21px; font-weight: 400; line-height: 1.1; text-align: left; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                {{ task.title | escape }}
              </div>
              {% if task.change_indicator %}
                <span style="flex: 0 0 auto; padding: 1px 6px; border: 1px solid #111; border-radius: 7px; background: #111; color: #fff; font-size: 17px; font-weight: 400; white-space: nowrap;">
                  {{- task.change_indicator | escape -}}
                </span>
              {% endif %}
              {% unless task.status == 'Ready' %}
                <span style="flex: 0 0 auto; padding: 1px 6px; border: 1px solid #777; border-radius: 7px; font-size: 21px; font-weight: 400; white-space: nowrap;">
                  {{- task.status | escape -}}
                </span>
              {% endunless %}
            </div>
          {% endfor %}
        {% endfor %}
        {% if stats.hidden_open > 0 %}
          <div style="padding: 2px; font-size: 21px;">+{{ stats.hidden_open }} more open</div>
        {% endif %}
      {% endif %}

      {% if stats.done_last_24h > 0 %}
        <div style="margin-top: auto;">
          <div style="display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 2px; border-bottom: 2px solid #111;">
            <span style="font-size: 26px; font-weight: 400;">Done</span>
            <span style="font-size: 26px; font-weight: 400;">{{ stats.done_last_24h }}</span>
          </div>
          {% for task in recent_done %}
            <div style="display: flex; align-items: center; gap: 9px; min-height: 38px; padding: 2px;">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                aria-hidden="true"
                style="flex: 0 0 auto; fill: currentColor;"
              >
                <path d="M17.28 9.28a.75.75 0 0 0-1.06-1.06l-5.97 5.97-2.47-2.47a.75.75 0 0 0-1.06 1.06l3 3a.75.75 0 0 0 1.06 0l6.5-6.5Z" />
                <path d="M12 1c6.075 0 11 4.925 11 11s-4.925 11-11 11S1 18.075 1 12 5.925 1 12 1ZM2.5 12a9.5 9.5 0 0 0 9.5 9.5 9.5 9.5 0 0 0 9.5-9.5A9.5 9.5 0 0 0 12 2.5 9.5 9.5 0 0 0 2.5 12Z" />
              </svg>
              <div style="min-width: 0; flex: 1; font-size: 21px; font-weight: 400; line-height: 1.1; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                {{ task.title | escape }}
              </div>
              <span style="flex: 0 0 auto; font-size: 21px; font-weight: 400; white-space: nowrap;">
                {{- task.completed_time | escape -}}
              </span>
            </div>
          {% endfor %}
          {% if stats.hidden_done > 0 %}
            <div style="padding: 2px; font-size: 21px;">+{{ stats.hidden_done }} more done</div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<div
  class="title_bar"
  style="display: flex; align-items: center; justify-content: space-between; font-family: 'Open Sans', sans-serif; font-weight: 400;"
>
  <span style="font-size: 21px; font-weight: 400;">
    {{- data.project.title | default: 'GitHub Project' | escape }} · My Tasks</span
  >
</div>
